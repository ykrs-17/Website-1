// Admin Authentication Guard Firewall
const requireAdminAuth = (req, res, next) => {
    const authCookie = req.signedCookies.admin_session;
    if (authCookie && authCookie === "authenticated_admin") {
        return next();
    }
    // Unauthorized hits get bounced directly to the login gate screen
    res.redirect('/admin/login');
};

const ipRequestTracker = {};
const rateLimiterFirewall = (req, res, next) => {
    const clientIp = req.ip || req.headers['x-forwarded-for'];
    const currentTime = Date.now();
    const timeframe = 15 * 60 * 1000;

    if (!ipRequestTracker[clientIp]) ipRequestTracker[clientIp] = [];
    ipRequestTracker[clientIp] = ipRequestTracker[clientIp].filter(ts => currentTime - ts < timeframe);

    if (ipRequestTracker[clientIp].length >= 5) {
        return res.status(429).json({ success: false, message: "Too many requests. Blocked for 15 minutes." });
    }
    ipRequestTracker[clientIp].push(currentTime);
    next();
};

