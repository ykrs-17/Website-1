// ---------------------------------------------------------
// 📄 ROUTE 2: PUBLIC UTR SUBMISSION PROCESSING API
// ---------------------------------------------------------
app.post('/api/verify-payment', rateLimiterFirewall, async (req, res) => {
    const { utr } = req.body;
    if (!utr || typeof utr !== 'string' || !/^[0-9]{12}$/.test(utr)) {
        return res.status(400).json({ success: false, message: "Security Flag: Invalid format structure." });
    }
    try {
        const duplicateCheck = await Transaction.findOne({ utr: utr });
        if (duplicateCheck) return res.status(409).json({ success: false, message: "This UTR is already under active review." });

        const newRecord = new Transaction({ id: crypto.randomUUID(), utr: utr });
        await newRecord.save();
        return res.status(200).json({ success: true, message: "UTR logged permanently. Activating within 1-2 hours." });
    } catch {
        return res.status(500).json({ success: false, message: "Server logging error." });
    }
});

